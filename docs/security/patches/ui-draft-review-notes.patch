+/** Plain, non-blocking reminders shown under a draft. They mention that something needs checking, never that it is wrong. */
+@Composable
+private fun ReviewNotes(draft: ReplyUi.Draft) {
+    val colors = AkmaTheme.colors
+    Column(Modifier.fillMaxWidth(), verticalArrangement = Arrangement.spacedBy(AkmaSpacing.xs)) {
+        draft.review.concerns.forEach { concern ->
+            val text = when (concern) {
+                GroundingConcern.UNGROUNDED_DETAIL -> R.string.akma_review_details
+                GroundingConcern.COMMITMENT_PHRASE -> R.string.akma_review_commitment
+                GroundingConcern.UNAVAILABILITY_CLAIM -> R.string.akma_review_availability
+            }
+            Text(stringResource(text), style = AkmaTheme.type.caption, color = colors.textSecondary)
+        }
+    }
+}
